{
  "name": "agency-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-placeholders.mjs",
    "build:preview": "SHOW_DRAFTS=1 astro build && node scripts/check-placeholders.mjs",
    "build:prod": "STRICT=1 astro build && STRICT=1 node scripts/check-placeholders.mjs",
    "preview": "astro preview",
    "test": "npm run build:preview && node tests/responsive.mjs && node tests/behavior.mjs",
    "lighthouse": "npm run build:preview && node tests/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0"
  }
}