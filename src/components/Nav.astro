---
import Txt from "./Txt.astro";
import { site } from "../site";
const { current = "" } = Astro.props;
const links = [["Work", "/work/"], ["Restaurants", "/restaurants/"], ["About", "/about/"]];
---
<header class="nav" id="site-header">
  <a class="wordmark" href="/">
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1" y="1" width="12" height="12" rx="2" stroke="#EAF4F2" stroke-width="1.5"/><rect x="4.5" y="4.5" width="5" height="5" fill="#EAF4F2"/></svg>
    <Txt s={site.name} plain />
  </a>
  <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-menu"><span class="bars" aria-hidden="true"></span><span class="lbl">Menu</span></button>
  <nav id="site-menu" aria-label="Main">
    {links.map(([label, href]) => <a class="ag-link" href={href} aria-current={current === href ? "page" : undefined}>{label}</a>)}
    <a class="ag-link pill-btn" href="/contact/" aria-current={current === "/contact/" ? "page" : undefined}>Contact us</a>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header")!;
  const btn = header.querySelector<HTMLButtonElement>(".menu-btn")!;
  const lbl = btn.querySelector(".lbl")!;
  const menu = document.getElementById("site-menu")!;
  const wide = matchMedia("(min-width: 900px)");
  const focusables = () => [...header.querySelectorAll<HTMLElement>("a[href], button")].filter((e) => e.getClientRects().length);

  function set(open: boolean, returnFocus = true) {
    header.classList.toggle("open", open);
    document.documentElement.classList.toggle("menu-open", open);
    btn.setAttribute("aria-expanded", String(open));
    lbl.textContent = open ? "Close" : "Menu";
    if (open) menu.querySelector<HTMLElement>("a")?.focus();
    else if (returnFocus) btn.focus();
  }
  btn.addEventListener("click", () => set(!header.classList.contains("open")));
  menu.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) set(false, false); });
  wide.addEventListener("change", () => wide.matches && header.classList.contains("open") && set(false, false));
  document.addEventListener("keydown", (e) => {
    if (!header.classList.contains("open")) return;
    if (e.key === "Escape") return set(false);
    if (e.key !== "Tab") return;
    const f = focusables(), first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
</script>
